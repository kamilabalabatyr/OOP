package pr3.delivery.app;

import pr3.delivery.model.Car;
import pr3.delivery.model.Engine;
import pr3.delivery.model.Truck;
import pr3.delivery.model.Vehicle;
import pr3.delivery.service.DeliveryService;

import java.util.ArrayList;
import java.util.List;

public class MainApp {
    public static void main(String[] args) {

        Engine e1 = new Engine("Petrol", 150);
        Engine e2 = new Engine("Diesel", 400);

        Car car1 = new Car("Toyota Camry", 2000, e1, 5);
        Truck truck1 = new Truck("Volvo FH", 5000, e2, 10); // maxLoad = 10 (условно)

        List<Vehicle> vehicles = new ArrayList<>();
        vehicles.add(car1);
        vehicles.add(truck1);

        DeliveryService service = new DeliveryService();

        service.printAllVehicles(vehicles);
        System.out.println();

        service.calculateAllDeliveries(vehicles);
        System.out.println("TOTAL (default): " + service.calculateTotalCost(vehicles));
        System.out.println();

        // Demonstrate OVERLOADING (extra methods)
        System.out.println("Car with extra weight cost: " + car1.calculateDeliveryCost(12.5));
        System.out.println("Truck with distance+fuel cost: " + truck1.calculateDeliveryCost(300, 0.8));
    }
}