package pr3.animal.app;

import pr3.animal.model.Animal;
import pr3.animal.model.Dog;

import java.util.ArrayList;
import java.util.List;

public class MainApp {
    public static void main(String[] args) {

        // at least one Animal object
        Animal a1 = new Dog("Buddy", 3, "Labrador");

        // at least two Dog objects
        Dog d1 = new Dog("Rex", 5, "German Shepherd");
        Dog d2 = new Dog("Milo", 2, "Beagle");

        List<Animal> animals = new ArrayList<>();
        animals.add(a1);
        animals.add(d1);
        animals.add(d2);

        // Polymorphism demo
        for (Animal a : animals) {
            System.out.println("-----");
            a.getInfo();
            a.makeSound();
            a.eat();
            a.eat("meat"); // overloaded eat
        }
    }
}